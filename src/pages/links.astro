---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { links } from "./[...slug].astro"
import { CopyableUsername } from "@/components/custom/copyableUsername"
import { icon } from "./index.astro"
import { HomeIcon } from "lucide-react"
import Title from "@/components/custom/title.astro"
import ButtonContainer from "@/components/custom/buttonContainer.astro"
---

<Layout title="Links">
  <Title subheader="Here are all important" header="LINKS" />

  <ButtonContainer>
    <ArrowEntry link="/">
      <HomeIcon className={icon} /> Back Home
    </ArrowEntry>

    {
      links
        .filter((link) => !link.hidden)
        .map((link) => (
          <ArrowEntry link={link.target} newWindow={true}>
            <link.icon class={icon} />
            <span>{link.name}</span>
            {link.username && (
              <CopyableUsername
                client:load
                username={link.username}
                isLinked={!!link.target}
              />
            )}
          </ArrowEntry>
        ))
    }
  </ButtonContainer>
</Layout>
