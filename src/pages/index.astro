---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { CodeXmlIcon, LinkIcon, MailIcon, UserRoundIcon } from "lucide-react"
import Title from "@/components/custom/title.astro"
import ButtonContainer from "@/components/custom/buttonContainer.astro"

// Icon classes
export const icon: string = "size-5"
---

<Layout>
  <Title subheader="A random internet user" header="TFJ" />

  <ButtonContainer>
    <!-- About me -->
    <ArrowEntry link="/about" className="h-full w-full">
      <UserRoundIcon className={icon} /> About Me
    </ArrowEntry>

    <!-- Links overview -->
    <ArrowEntry link="/links" className="h-full w-full">
      <LinkIcon className={icon} /> Links
    </ArrowEntry>

    <!-- Contact -->
    <ArrowEntry link="/contact" className="h-full w-full">
      <MailIcon className={icon} /> Contact
    </ArrowEntry>

    <!-- Source code -->
    <ArrowEntry link="/source-code" className="h-full w-full opacity-70">
      <CodeXmlIcon className={icon} /> View source code
    </ArrowEntry>
  </ButtonContainer>
</Layout>
