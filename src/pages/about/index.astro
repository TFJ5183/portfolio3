---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { HomeIcon, QuoteIcon, UserRoundIcon } from "lucide-react"
import Title from "@/components/custom/title.astro"
import { icon } from "../index.astro"
import ButtonContainer from "@/components/custom/buttonContainer.astro"
---

<Layout title="About me">
  <Title subheader="Learn more about" header="ME" className="" />

  <ButtonContainer>
    <ArrowEntry link="/" className="h-full w-full">
      <HomeIcon className={icon} /> Back home
    </ArrowEntry>

    <ArrowEntry link="/about/who-am-i" className="h-full w-full">
      <UserRoundIcon className={icon} /> Who am I?
    </ArrowEntry>

    <ArrowEntry link="/about/favorite-quotes" className="h-full w-full">
      <QuoteIcon className={icon} /> Favorite Quotes
    </ArrowEntry>
  </ButtonContainer>
</Layout>
