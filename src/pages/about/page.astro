---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { HomeIcon } from "lucide-react"
import { icon } from "../index.astro"
import Title from "@/components/custom/title.astro"
import Prose from "@/components/custom/prose.astro"

// Now date
const now = new Date()

// Formatted date (dd.mm.yyyy - hh.mm.ss)
const formatted =
  String(now.getDate()).padStart(2, "0") +
  "." +
  String(now.getMonth() + 1).padStart(2, "0") +
  "." +
  now.getFullYear() +
  " - " +
  String(now.getHours()).padStart(2, "0") +
  ":" +
  String(now.getMinutes()).padStart(2, "0") +
  ":" +
  String(now.getSeconds()).padStart(2, "0")
---

<Layout title="Deployment info">
  <Title subheader="Infos about this" header="Page" className="" />

  <Prose className="text-lg">
    <p>
      Deployment Time: {formatted}
    </p>
    <p>
      Deployed with
      <a href="https://docs.github.com/en/pages" target="_blank">GitHub Pages</a>
    </p>

    <p>I try to keep this website updated but I cant promise anything</p>

    <p>
      The background image is from Cyberpunk 2077 and was taken by me using the
      in-game photo mode.
    </p>

    <p>
      This page (and the rest of the site) does not collect any personal data.
    </p>
  </Prose>

  <ul class="mt-12 max-w-md space-y-2">
    <ArrowEntry link="/" className="h-full w-full">
      <HomeIcon className={icon} /> Back home
    </ArrowEntry>
  </ul>
</Layout>
