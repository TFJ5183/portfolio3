---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { LinkIcon, QuoteIcon, UserRoundIcon } from "lucide-react"
import { icon } from "../index.astro"
import Title from "@/components/custom/title.astro"
import Prose from "@/components/custom/prose.astro"
import ButtonContainer from "@/components/custom/buttonContainer.astro"
---

<Layout title="Who am I?">
  <Title subheader="Who" header="AM I?" />

  <Prose>
    <p>
      I am TFJ, an IT Specialist apprentice for Application Development.
      Basically, I turn caffeine into code and hope for the best (well actually
      I just drink water).
    </p>

    <p>
      When I'm not "apprenticing" (which is a fancy word for learning why my
      code broke), I'm working on side projects that may or may not ever see the
      light of day.
    </p>

    <p>
      I have a deep-seated love for the Cyberpunk genre - because who doesnt
      want to know, how it feels if your broke (well you could basically look
      into the mirror, but I want want to be mean xD)
    </p>

    <p>
      As for the domain <code class="text-primary">thekoi.dev</code>? I find
      fish fascinating, especially Kois. They just swim around, look pretty, and
      don't have to deal with merge conflicts. Living the dream, honestly.
    </p>
  </Prose>

  <ButtonContainer>
    <ArrowEntry link="/about" className="block h-full w-full">
      <UserRoundIcon className={icon} /> Back to About
    </ArrowEntry>
    <ArrowEntry link="/links" className="block h-full w-full">
      <LinkIcon className={icon} /> You may know me from
    </ArrowEntry>
    <ArrowEntry link="/about/favorite-quotes" className="block h-full w-full">
      <QuoteIcon className={icon} /> My favorites quotes
    </ArrowEntry>
  </ButtonContainer>
</Layout>
