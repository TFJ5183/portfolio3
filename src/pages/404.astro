---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { HomeIcon } from "lucide-react"
import { icon } from "./index.astro"
import Title from "@/components/custom/title.astro"
import Prose from "@/components/custom/prose.astro"
import ButtonContainer from "@/components/custom/buttonContainer.astro"
---

<Layout title="404 - yikes">
  <Title subheader="Are you" header="LOST?" className="" />

  <Prose className="text-lg">
    <p>
      The page you are looking for doesn't exist or has been moved to another
      dimension. Let's get you back to safety.
    </p>
  </Prose>

  <ButtonContainer>
    <ArrowEntry link="/" className="h-full w-full">
      <HomeIcon className={icon} /> Back to Home
    </ArrowEntry>
  </ButtonContainer>
</Layout>
