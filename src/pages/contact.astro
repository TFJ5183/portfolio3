---
import ArrowEntry from "@/components/custom/arrowEntry.astro"
import Layout from "@/layouts/main.astro"
import { discord } from "./[...slug].astro"
import { HomeIcon, LinkIcon } from "lucide-react"
import { icon } from "./index.astro"

import Title from "@/components/custom/title.astro"
import Prose from "@/components/custom/prose.astro"
import { CopyableUsername } from "@/components/custom/copyableUsername.tsx"
import ButtonContainer from "@/components/custom/buttonContainer.astro"
---

<Layout title="Conact">
  <Title subheader="This is how, you can" header="Contact Me" />

  <Prose>
    <p class="flex">
      Im open the get contacted over discord <CopyableUsername
        className="text-current"
        client:load
        username={discord.username!}
        isLinked={false}
      /> :)
    </p>
    <p>I cannot be hired</p>
  </Prose>

  <ButtonContainer>
    <ArrowEntry link="/" className="h-full w-full">
      <HomeIcon className={icon} /> Back home
    </ArrowEntry>

    <ArrowEntry link="/links" className="h-full w-full">
      <LinkIcon className={icon} /> To Links
    </ArrowEntry>
  </ButtonContainer>
</Layout>
