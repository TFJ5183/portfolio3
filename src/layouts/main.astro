---
import "@/styles/global.css"
import ClientRouter from "astro/components/ClientRouter.astro"
import { Font } from "astro:assets"
import Footer from "@/components/custom/footer.astro"

// Props typ
interface Props {
  title?: string
}

// Props
const { title = "" } = Astro.props

// Suffix
const siteTitle = "The Koi [dot] dev"

// Page title result
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle
---

<!-- Template -->
<html lang="en">
  <!-- Head -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/t.png" />
    <title>{pageTitle}</title>
    <Font cssVariable="--marker-font" preload={true} />
  </head>
  <!-- Body -->
  <body class="relative min-h-screen">
    <!-- Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <img
        alt="background"
        src="/backgrounds/bar.png"
        class="absolute inset-0 h-full w-full object-cover object-[70%_center] md:object-center blur-xs select-none"
      />
      <div
        class="absolute inset-0 bg-linear-to-r from-black to-black/10 md:to-transparent lg:via-black/25"
      >
      </div>
    </div>

    <!-- Client-side router -->
    <ClientRouter />

    <div class="relative flex min-h-screen flex-col">
      {/* Page content */}
      <main class="relative flex flex-1 flex-col justify-center">
        <div class="px-4 py-12 md:px-20">
          <slot />
        </div>
      </main>

      <!-- Footer -->
      <Footer />
    </div>
  </body>
</html>
